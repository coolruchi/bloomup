        <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(112,26,117,0.78),rgba(112,26,117,0.25) 60%,transparent)"></div>
        <div style="position:absolute;top:50%;left:2.5rem;transform:translateY(-50%);color:#fff;max-width:400px">
          <div style="color:#f0abfc;font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:0.75rem">📍 ${d.address||'Durham Region'}</div>
          <h1 style="font-size:2.1rem;font-weight:900;line-height:1.2;margin-bottom:0.75rem">${d.tagline}</h1>
          <p style="color:rgba(255,255,255,0.85);font-size:0.87rem;margin-bottom:1.5rem;line-height:1.6">${d.about||'Carefully curated collections for every style and occasion. Shop local, feel great.'}</p>
          <a href="tel:${d.phone}" style="background:#fff;color:${d.primary};padding:0.75rem 1.5rem;border-radius:99px;font-weight:800;text-decoration:none;font-size:0.87rem">Shop Now →</a>
        </div>
      </div>
      <div style="background:#fdf4ff;padding:1.25rem 2rem;display:flex;gap:2rem;justify-content:center;flex-wrap:wrap;border-bottom:1px solid #fae8ff">
        ${[`📍 ${d.address||'Durham Region'}`,`📞 ${d.phone||'Call us'}`,`🚚 Free Local Delivery`].map(i=>`<span style="font-size:0.82rem;font-weight:600;color:${d.primary}">${i}</span>`).join('')}
      </div>
      <div style="background:#fff;padding:2.5rem 2rem">
        <h2 style="font-size:1.3rem;font-weight:800;text-align:center;margin-bottom:2rem;color:${d.primary}">What We Offer</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0.85rem">
          ${d.services.map(s=>`<div style="background:#fdf4ff;border:1px solid #fae8ff;border-radius:10px;padding:1rem;text-align:center"><div style="font-size:1.3rem;margin-bottom:0.4rem">🛍</div><div style="font-size:0.82rem;font-weight:600;color:${d.primary}">${s}</div></div>`).join('')}
        </div>
      </div>
      <div style="background:linear-gradient(135deg,${d.primary},#86198f);color:#fff;padding:2.5rem;text-align:center">
        <h2 style="font-size:1.3rem;font-weight:800;margin-bottom:0.5rem">Come Visit Us Today</h2>
        <p style="color:#f0abfc;margin-bottom:1.25rem;font-size:0.87rem">${d.address||'Durham Region'} · ${d.phone||''}</p>
        <a href="tel:${d.phone}" style="background:#fff;color:${d.primary};padding:0.8rem 1.75rem;border-radius:99px;font-weight:800;text-decoration:none">Get Directions →</a>
      </div>
      <footer style="background:#3b0764;color:#701a75;text-align:center;padding:1rem;font-size:0.78rem">© ${new Date().getFullYear()} ${d.name}</footer>`;
    }
  }
};

let currentTemplate = 'trades';
let services = [];

// SECTION TOGGLE
function toggleSection(header) {
  header.classList.toggle('open');
  const body = header.nextElementSibling;
  body.classList.toggle('open');
}

// TEMPLATE SELECTION — loads unique defaults per industry
function selectTemplate(id, el) {
  document.querySelectorAll('.template-thumb').forEach(t => t.classList.remove('selected'));
  el.classList.add('selected');
  currentTemplate = id;
  const tpl = TEMPLATES[id];
  if (tpl) {
    // Load default services if user hasn't added any
    if (services.length === 0) {
      services = [...tpl.defaultServices];
      renderServices();
    }
    // Suggest industry-specific tagline if still on placeholder
    const tagEl = document.getElementById('tagline');
    if (!tagEl.value || tagEl.value === 'Fast, Reliable, Professional') {
      tagEl.value = tpl.defaultTagline;
    }
    // Set industry-matched colors
    document.getElementById('primaryColor').value = tpl.primaryColor;
    document.getElementById('accentColor').value  = tpl.accentColor;
  }
  updatePreview();
}

// SERVICES
function renderServices() {
  const chips = document.getElementById('servicesChips');
  chips.innerHTML = services.map((s, i) => `
    <div class="service-chip">${s}
      <button class="service-chip-remove" onclick="removeService(${i})" title="Remove">×</button>
    </div>`).join('');
}
function addService() {
  const input = document.getElementById('serviceInput');
  const val = input.value.trim();
  if (val && services.length < 8) {
    services.push(val); input.value = '';
    renderServices(); updatePreview();
  }
}
function removeService(i) {
  services.splice(i, 1); renderServices(); updatePreview();
}

// BUILD PREVIEW — calls the unique renderer for the selected template
function buildPreviewHTML() {
  const tpl = TEMPLATES[currentTemplate] || TEMPLATES.trades;
  const data = {
    name:    document.getElementById('brandName').value    || 'Your Business',
    tagline: document.getElementById('tagline').value      || tpl.defaultTagline,
    primary: document.getElementById('primaryColor').value || tpl.primaryColor,
    accent:  document.getElementById('accentColor').value  || tpl.accentColor,
    phone:   document.getElementById('phone').value        || '(905) 555-0100',
    email:   document.getElementById('email').value        || '',
    address: document.getElementById('address').value      || 'Durham Region, ON',
    about:   document.getElementById('aboutText').value    || '',
    services: services.length ? services : tpl.defaultServices,
    heroImg:  tpl.heroImg
  };
  return `<!DOCTYPE html><html lang="en"><head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title>${data.name}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Inter',sans-serif;color:#1a1a1a;background:#fff}</style>
  </head><body>${tpl.render(data)}</body></html>`;
}

// UPDATE PREVIEW
function updatePreview() {
  document.getElementById('preview-iframe').srcdoc = buildPreviewHTML();
  document.getElementById('previewTitle').textContent =
    document.getElementById('brandName').value || 'Your Business';
}

// DEVICE MODES
function setDevice(device, btn) {
  document.querySelectorAll('.device-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const iframe = document.getElementById('preview-iframe');
  iframe.classList.remove('mobile-view', 'tablet-view');
  if (device === 'mobile') iframe.classList.add('mobile-view');
  if (device === 'tablet') iframe.classList.add('tablet-view');
}

// FULL SCREEN PREVIEW
function openFullPreview() {
  const win = window.open('', '_blank');
  win.document.write(buildPreviewHTML());
  win.document.close();
}

// SAVE DEMO
function saveDemo() {
  const name = document.getElementById('brandName').value.trim();
  if (!name || name === 'Your Business Name') {
    showToast('Please enter your business name first', 'error'); return;
  }
  fetch('/builder/save', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      template_id:     currentTemplate,
      brand_name:      document.getElementById('brandName').value,
      tagline:         document.getElementById('tagline').value,
      primary_color:   document.getElementById('primaryColor').value,
      secondary_color: document.getElementById('accentColor').value,
      services,
      phone:   document.getElementById('phone').value,
      email:   document.getElementById('email').value,
      address: document.getElementById('address').value,
      about_text: document.getElementById('aboutText').value
    })
  })
  .then(r => r.json())
  .then(res => {
    if (res.success) showToast('✓ Saved! Link: ' + res.url, 'success', 6000);
    else showToast(res.error || 'Save failed', 'error');
  })
  .catch(() => showToast('Network error', 'error'));
}

// Init — load first template defaults
const firstTpl = TEMPLATES[currentTemplate];
services = [...firstTpl.defaultServices];
document.getElementById('tagline').value       = firstTpl.defaultTagline;
document.getElementById('primaryColor').value  = firstTpl.primaryColor;
document.getElementById('accentColor').value   = firstTpl.accentColor;
renderServices();
updatePreview();

// Auto-detect industry from URL param: ?industry=salon
const urlParams = new URLSearchParams(window.location.search);
const industry = urlParams.get('industry');
if (industry) {
  const matchKey = Object.keys(TEMPLATES).find(k => k === industry.toLowerCase()) || 'trades';
  const thumb = document.querySelector(`[data-template="${matchKey}"]`);
  if (thumb) { services = []; selectTemplate(matchKey, thumb); }
}
</script>
