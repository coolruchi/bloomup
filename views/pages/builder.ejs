          <div style="background:rgba(134,239,172,0.2);border:1px solid rgba(134,239,172,0.4);color:#86efac;display:inline-block;padding:0.25rem 0.75rem;border-radius:99px;font-size:0.72rem;font-weight:700;margin-bottom:0.75rem">SERVING ${(d.address||'DURHAM REGION').toUpperCase()}</div>
          <h1 style="font-size:2.1rem;font-weight:900;line-height:1.2;margin-bottom:0.75rem">${d.tagline}</h1>
          <p style="color:rgba(255,255,255,0.85);font-size:0.88rem;margin-bottom:1.5rem;line-height:1.6">${d.about||'Professional landscaping for residential and commercial properties.'}</p>
          <a href="tel:${d.phone}" style="background:#86efac;color:#14532d;padding:0.75rem 1.5rem;border-radius:8px;font-weight:800;text-decoration:none;font-size:0.88rem">Get Free Estimate →</a>
        </div>
      </div>
      <div style="background:#f0fdf4;padding:2.5rem 2rem">
        <h2 style="font-size:1.3rem;font-weight:800;text-align:center;color:#14532d;margin-bottom:2rem">Our Services</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem">
          ${d.services.map(s=>`<div style="background:#fff;border:1px solid #bbf7d0;border-radius:10px;padding:1.25rem;border-left:4px solid ${d.primary}"><div style="font-size:1.3rem;margin-bottom:0.4rem">🌱</div><div style="font-weight:700;font-size:0.85rem;color:#14532d">${s}</div></div>`).join('')}
        </div>
      </div>
      <div style="background:${d.primary};color:#fff;padding:2.5rem;text-align:center">
