<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'BloomUp — Professional Websites & AI Voice Agents for Local Businesses. Get found online. Never miss a call.' %>">
  <title><%= typeof title !== 'undefined' ? title + ' | BloomUp' : 'BloomUp — Digital Growth for Local Businesses' %></title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

  <!-- CSS -->
  <link rel="stylesheet" href="/css/main.css">
  <% if (typeof extraCss !== 'undefined') { %><link rel="stylesheet" href="<%= extraCss %>"><% } %>

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%237c3aed'/><text y='.9em' font-size='70' x='15'>🌱</text></svg>">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">

<nav class="nav" id="mainNav">
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">🌱</div>
    Bloom<span>Up</span>
  </a>

  <ul class="nav-links">
    <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
    <li><a href="/builder" class="<%= currentPath === '/builder' ? 'active' : '' %>">Website Builder</a></li>
    <li><a href="/voice-agent" class="<%= currentPath === '/voice-agent' ? 'active' : '' %>">AI Voice Agent</a></li>
    <li><a href="/#pricing">Pricing</a></li>
    <li><a href="/#contact">Contact</a></li>
  </ul>

  <div class="nav-actions">
    <% if (user) { %>
      <% if (user.role === 'admin') { %>
        <a href="/admin" class="btn btn-ghost btn-sm">Dashboard</a>
      <% } %>
      <a href="/auth/logout" class="btn btn-ghost btn-sm">Sign Out</a>
    <% } else { %>
      <a href="/auth/login" class="btn btn-ghost btn-sm">Sign In</a>
      <a href="/auth/register" class="btn btn-primary btn-sm">Get Started Free</a>
    <% } %>
  </div>

  <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
    <span></span><span></span><span></span>
  </button>
</nav>
