        <p style="color:#fce7f3;margin-bottom:1.25rem;font-size:0.88rem">Call us or book online · ${d.address||'Durham Region'}</p>
        <a href="tel:${d.phone}" style="background:#fff;color:${d.primary};padding:0.8rem 2rem;border-radius:99px;font-weight:800;text-decoration:none">📞 Book Now</a>
      </div>
      <footer style="background:#1a1a1a;color:#6b7280;text-align:center;padding:1rem;font-size:0.78rem">© ${new Date().getFullYear()} ${d.name} · ${d.email||''}</footer>`;
    }
  },

  restaurant: {
    primaryColor: '#92400e', accentColor: '#fbbf24',
    defaultServices: ['Dine-In','Takeout & Delivery','Catering','Private Events','Daily Specials','Family Meals'],
    defaultTagline: 'Fresh. Local. Unforgettable.',
    heroImg: 'photo-1555396273-367ea4eb4db5',
    render(d) {
      return `<nav style="position:absolute;top:0;left:0;right:0;z-index:10;padding:1rem 2rem;display:flex;align-items:center;justify-content:space-between">
        <div style="color:#fff;font-weight:900;font-size:1.3rem;text-shadow:0 1px 4px rgba(0,0,0,0.5)">${d.name}</div>
        <div style="display:flex;gap:1.5rem">
          ${['Menu','About','Reserve'].map(l=>`<a href="#" style="color:rgba(255,255,255,0.9);font-size:0.87rem;font-weight:600;text-decoration:none">${l}</a>`).join('')}
        </div>
      </nav>
      <div style="position:relative;height:460px;overflow:hidden">
        <img src="https://images.unsplash.com/${d.heroImg}?w=1200&h=460&q=85&auto=format&fit=crop" style="width:100%;height:100%;object-fit:cover">
        <div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,0.3),rgba(0,0,0,0.65))"></div>
        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#fff;padding:2rem">
          <div style="font-size:0.75rem;letter-spacing:0.15em;text-transform:uppercase;color:${d.accent};font-weight:700;margin-bottom:0.75rem">${d.address||'Durham Region'}</div>
