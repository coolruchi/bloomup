      </div>
      <footer style="background:#0f172a;color:#64748b;text-align:center;padding:1rem;font-size:0.78rem">© ${new Date().getFullYear()} ${d.name} · ${d.address||'Durham Region'}</footer>`;
    }
  },

  salon: {
    primaryColor: '#be185d', accentColor: '#f9a8d4',
    defaultServices: ['Haircuts & Styling','Colour & Highlights','Blowouts','Keratin Treatment','Manicure & Pedicure','Waxing'],
    defaultTagline: 'Where Beauty Meets Expertise',
    heroImg: 'photo-1522337360788-8b13dee7a37e',
    render(d) {
      return `<nav style="background:#fff;padding:0 1.5rem;height:64px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #fce7f3">
        <div style="color:${d.primary};font-weight:800;font-size:1.15rem;font-style:italic">✦ ${d.name}</div>
        <div style="display:flex;gap:1rem;align-items:center">
          <span style="font-size:0.82rem;color:#9ca3af">${d.phone||''}</span>
          <a href="#book" style="background:${d.primary};color:#fff;padding:0.4rem 1.1rem;border-radius:99px;font-size:0.82rem;font-weight:600;text-decoration:none">Book Now</a>
