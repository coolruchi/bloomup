        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1rem;max-width:680px;margin:0 auto">
          ${d.services.map(s=>`<div style="background:#fffbf0;border:1px solid #fef3c7;border-radius:10px;padding:1rem;text-align:center"><div style="font-size:1.4rem;margin-bottom:0.4rem">🍽</div><div style="font-size:0.82rem;font-weight:600">${s}</div></div>`).join('')}
        </div>
      </div>
      <footer style="background:#1c0a00;color:#78350f;text-align:center;padding:1.25rem;font-size:0.78rem">© ${new Date().getFullYear()} ${d.name} · ${d.address||'Durham Region'} · ${d.phone||''}</footer>`;
    }
  },

  landscaping: {
    primaryColor: '#166534', accentColor: '#86efac',
    defaultServices: ['Lawn Maintenance','Garden Design','Sodding & Seeding','Tree Trimming','Snow Removal','Interlocking'],
    defaultTagline: 'Transforming Outdoor Spaces Since Day One',
    heroImg: 'photo-1416879595882-3373a0480b5b',
    render(d) {
      return `<nav style="background:${d.primary};padding:0 1.5rem;height:60px;display:flex;align-items:center;justify-content:space-between">
        <div style="color:#fff;font-weight:800;font-size:1.05rem">🌿 ${d.name}</div>
        <div style="display:flex;gap:0.75rem;align-items:center">
