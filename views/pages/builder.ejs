<%- include('../partials/header', { title: 'Website Builder', bodyClass: 'no-footer-padding', extraJs: '/js/builder.js' }) %>

<div class="builder-layout">

  <!-- ===== LEFT PANEL: CONTROLS ===== -->
  <div class="builder-panel">
    <div class="builder-panel-header">
      <h2>🎨 Build Your Website</h2>
      <p>Customize below — preview updates live on the right</p>
    </div>
    <div class="builder-panel-body">

      <!-- STEP 1: Template -->
      <div class="builder-section">
        <div class="builder-section-header open" onclick="toggleSection(this)">
          <span>📐 Step 1 — Choose Template</span>
          <span class="arrow">▼</span>
        </div>
        <div class="builder-section-body open">
          <div class="template-grid" id="templateGrid">
            <% const templates = [
              {id:'trades',label:'Trades Pro',img:'photo-1558618666-fcd25c85cd64'},
              {id:'salon',label:'Salon & Spa',img:'photo-1522337360788-8b13dee7a37e'},
              {id:'restaurant',label:'Restaurant',img:'photo-1555396273-367ea4eb4db5'},
              {id:'landscaping',label:'Landscaping',img:'photo-1416879595882-3373a0480b5b'},
              {id:'auto',label:'Auto Repair',img:'photo-1486006920555-c77dcf18193c'},
              {id:'cleaning',label:'Cleaning',img:'photo-1581578731548-c64695cc6952'},
              {id:'gym',label:'Fitness & Gym',img:'photo-1534438327276-14e5300c3a48'},
              {id:'medical',label:'Health & Medical',img:'photo-1576091160399-112ba8d25d1d'},
              {id:'legal',label:'Professional',img:'photo-1507003211169-0a1dd7228f2d'},
              {id:'retail',label:'Retail & Shop',img:'photo-1441986300917-64674bd600d8'}
            ] %>
            <% templates.forEach((t, i) => { %>
            <div class="template-thumb <%= i === 0 ? 'selected' : '' %>" data-template="<%= t.id %>" onclick="selectTemplate('<%= t.id %>', this)">
              <img src="https://images.unsplash.com/<%= t.img %>?w=200&h=150&q=60&auto=format&fit=crop" alt="<%= t.label %>">
              <div class="template-thumb-label"><%= t.label %></div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- STEP 2: Brand -->
      <div class="builder-section">
        <div class="builder-section-header open" onclick="toggleSection(this)">
          <span>🏷 Step 2 — Your Brand</span>
          <span class="arrow">▼</span>
        </div>
        <div class="builder-section-body open">
          <div class="form-group">
            <label class="form-label">Business Name *</label>
            <input type="text" id="brandName" class="form-input" placeholder="e.g. Mike's Plumbing" oninput="updatePreview()" value="Your Business Name">
          </div>
          <div class="form-group">
            <label class="form-label">Tagline</label>
            <input type="text" id="tagline" class="form-input" placeholder="e.g. Fast, Reliable, Local" oninput="updatePreview()" value="Fast, Reliable, Professional">
          </div>
          <div class="grid-2" style="gap:0.75rem">
            <div class="form-group">
              <label class="form-label">Primary Color</label>
              <input type="color" id="primaryColor" value="#7c3aed" onchange="updatePreview()">
            </div>
            <div class="form-group">
              <label class="form-label">Accent Color</label>
              <input type="color" id="accentColor" value="#06d6a0" onchange="updatePreview()">
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 3: Services -->
      <div class="builder-section">
        <div class="builder-section-header" onclick="toggleSection(this)">
          <span>🛠 Step 3 — Services</span>
          <span class="arrow">▼</span>
        </div>
        <div class="builder-section-body">
          <div class="services-chips" id="servicesChips"></div>
          <div style="display:flex;gap:0.5rem">
            <input type="text" id="serviceInput" class="form-input" placeholder="e.g. Drain Cleaning" style="flex:1" onkeydown="if(event.key==='Enter'){addService();event.preventDefault()}">
            <button class="btn btn-primary btn-sm" onclick="addService()">Add</button>
          </div>
          <p class="form-hint mt-sm">Press Enter or click Add. Up to 8 services.</p>
        </div>
      </div>

      <!-- STEP 4: Contact -->
      <div class="builder-section">
        <div class="builder-section-header" onclick="toggleSection(this)">
          <span>📞 Step 4 — Contact Info</span>
          <span class="arrow">▼</span>
        </div>
        <div class="builder-section-body">
          <div class="form-group">
            <label class="form-label">Phone Number</label>
            <input type="tel" id="phone" class="form-input" placeholder="(905) 555-0100" oninput="updatePreview()">
          </div>
          <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" id="email" class="form-input" placeholder="info@yourbusiness.com" oninput="updatePreview()">
          </div>
          <div class="form-group">
            <label class="form-label">Address / Service Area</label>
            <input type="text" id="address" class="form-input" placeholder="Oshawa, ON" oninput="updatePreview()">
          </div>
        </div>
      </div>

      <!-- STEP 5: About -->
      <div class="builder-section">
        <div class="builder-section-header" onclick="toggleSection(this)">
          <span>📝 Step 5 — About You</span>
          <span class="arrow">▼</span>
        </div>
        <div class="builder-section-body">
          <div class="form-group">
            <label class="form-label">About Your Business</label>
            <textarea id="aboutText" class="form-textarea" placeholder="Tell customers about your business, experience, and what makes you different..." oninput="updatePreview()" rows="4"></textarea>
          </div>
        </div>
      </div>

      <!-- SAVE / CONTACT -->
      <div style="padding:1rem 0;border-top:1px solid var(--border-subtle);margin-top:1rem">
        <% if (user) { %>
          <button class="btn btn-primary w-full btn-lg mb-sm" onclick="saveDemo()">💾 Save My Demo Site</button>
        <% } else { %>
          <a href="/auth/register?redirect=/builder" class="btn btn-primary w-full btn-lg mb-sm" style="display:flex;justify-content:center">
            💾 Save My Demo Site
          </a>
          <p class="form-hint text-center">Free account required to save</p>
        <% } %>
        <a href="/#contact" class="btn btn-ghost w-full mt-sm" style="display:flex;justify-content:center">
          📩 Get This Built For Me →
        </a>
      </div>

    </div>
  </div>

  <!-- ===== RIGHT: PREVIEW ===== -->
  <div class="builder-preview">
    <div class="preview-toolbar">
      <div style="font-size:0.82rem;color:var(--text-muted)">
        <span id="previewTitle">Your Business Name</span> — Live Preview
      </div>
      <div class="preview-device-btns">
        <button class="device-btn active" onclick="setDevice('desktop', this)">🖥 Desktop</button>
        <button class="device-btn" onclick="setDevice('tablet', this)">📱 Tablet</button>
        <button class="device-btn" onclick="setDevice('mobile', this)">📱 Mobile</button>
      </div>
      <button class="btn btn-accent btn-sm" onclick="openFullPreview()">⛶ Full Screen</button>
    </div>
    <div class="preview-frame-wrap" id="previewWrap">
      <iframe id="preview-iframe" title="Website Preview" sandbox="allow-scripts allow-same-origin"></iframe>
    </div>
  </div>

</div>

<!-- Save demo modal -->
<div id="saveDemoModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:9000;display:none;align-items:center;justify-content:center;padding:1rem">
  <div style="background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:20px;padding:2rem;max-width:440px;width:100%">
    <h3 style="margin-bottom:0.5rem">Save your demo site</h3>
    <p style="font-size:0.87rem;color:var(--text-muted);margin-bottom:1.5rem">Enter your email and we'll send you a link you can share or revisit anytime.</p>
    <div class="form-group">
      <label class="form-label">Email Address</label>
      <input type="email" id="saveEmail" class="form-input" placeholder="you@example.com">
    </div>
    <div style="display:flex;gap:0.75rem">
      <button class="btn btn-primary" onclick="confirmSave()" style="flex:1">Save & Get Link</button>
      <button class="btn btn-ghost" onclick="closeSaveModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
// ============================================================
// TEMPLATE DATA — unique layout + defaults per industry
// ============================================================
const TEMPLATES = {

  trades: {
    primaryColor: '#1e3a8a', accentColor: '#f59e0b',
    defaultServices: ['Emergency Plumbing','Drain Cleaning','Water Heater Install','Leak Detection','Pipe Repair','Fixture Install'],
    defaultTagline: 'Fast Emergency Response — Licensed & Insured',
    heroImg: 'photo-1558618666-fcd25c85cd64',
    render(d) {
      return `<nav style="background:${d.primary};padding:0 1.5rem;height:60px;display:flex;align-items:center;justify-content:space-between">
        <div style="color:#fff;font-weight:800;font-size:1.1rem">🔧 ${d.name}</div>
        <a href="tel:${d.phone}" style="background:${d.accent};color:#1a1a1a;padding:0.4rem 1rem;border-radius:6px;font-weight:700;font-size:0.85rem;text-decoration:none">📞 ${d.phone||'Call Now'}</a>
      </nav>
      <div style="background:linear-gradient(135deg,#0f172a,#1e3a8a);color:#fff;padding:3.5rem 2rem;text-align:center">
        <div style="display:inline-block;background:rgba(245,158,11,0.2);border:1px solid #f59e0b;color:#fcd34d;padding:0.3rem 1rem;border-radius:99px;font-size:0.75rem;font-weight:700;margin-bottom:1rem">⚡ 24/7 EMERGENCY SERVICE AVAILABLE</div>
        <h1 style="font-size:2.2rem;font-weight:900;line-height:1.15;margin-bottom:0.75rem">${d.tagline}</h1>
        <p style="color:#93c5fd;margin-bottom:2rem;font-size:0.95rem">Serving ${d.address||'Durham Region'} · Response in 60 min or less</p>
        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
          <a href="tel:${d.phone}" style="background:${d.accent};color:#1a1a1a;padding:0.8rem 1.75rem;border-radius:8px;font-weight:800;font-size:0.95rem;text-decoration:none">📞 Emergency Call</a>
          <a href="#services" style="border:2px solid rgba(255,255,255,0.3);color:#fff;padding:0.8rem 1.75rem;border-radius:8px;font-weight:700;font-size:0.95rem;text-decoration:none">View Services</a>
        </div>
      </div>
      <div style="background:#f8fafc;padding:1rem 2rem;display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap;border-bottom:1px solid #e2e8f0">
        ${['✓ Licensed & Insured','✓ Upfront Pricing','✓ Satisfaction Guaranteed','✓ Background Checked'].map(b=>`<span style="font-size:0.82rem;font-weight:600;color:#1e3a8a">${b}</span>`).join('')}
      </div>
      <div style="padding:3rem 2rem" id="services">
        <h2 style="font-size:1.4rem;font-weight:800;text-align:center;margin-bottom:2rem">Our Services</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem">
          ${d.services.map(s=>`<div style="background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:1.25rem;text-align:center;border-top:3px solid ${d.primary}"><div style="font-size:1.5rem;margin-bottom:0.5rem">🔧</div><div style="font-weight:600;font-size:0.85rem">${s}</div></div>`).join('')}
        </div>
      </div>
      <div style="background:#1e3a8a;color:#fff;padding:2.5rem;text-align:center">
