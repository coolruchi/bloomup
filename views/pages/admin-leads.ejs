<%- include('../partials/header', { title: 'Leads' }) %>
<div class="admin-layout">
  <aside class="admin-sidebar">
    <div style="padding:1rem 1.5rem;border-bottom:1px solid var(--border-subtle);margin-bottom:0.5rem">
      <div style="font-size:0.72rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted)">BloomUp Admin</div>
    </div>
    <a href="/admin" class="admin-nav-item"><span class="admin-nav-icon">📊</span> Overview</a>
    <a href="/admin/leads" class="admin-nav-item active"><span class="admin-nav-icon">📋</span> Leads</a>
    <a href="/admin/demos" class="admin-nav-item"><span class="admin-nav-icon">🌐</span> Website Demos</a>
    <a href="/admin/voice-configs" class="admin-nav-item"><span class="admin-nav-icon">🎙</span> Voice Agents</a>
    <a href="/admin/users" class="admin-nav-item"><span class="admin-nav-icon">👥</span> Users</a>
    <a href="/admin/calls" class="admin-nav-item"><span class="admin-nav-icon">📞</span> Demo Calls</a>
    <div style="padding:1rem 1.5rem;border-top:1px solid var(--border-subtle);margin-top:auto">
      <a href="/" class="admin-nav-item" style="padding:0.5rem 0"><span class="admin-nav-icon">🌱</span> Back to Site</a>
      <a href="/auth/logout" class="admin-nav-item" style="padding:0.5rem 0;color:var(--bloom-danger)"><span class="admin-nav-icon">→</span> Sign Out</a>
    </div>
  </aside>
  <main class="admin-content">
    <div class="admin-page-title">Leads</div>
    <div class="admin-page-sub"><%= leads.length %> total leads collected</div>

    <div class="data-table-wrap">
      <table class="data-table">
        <thead><tr>
          <th>Name</th><th>Email</th><th>Phone</th><th>Business</th>
          <th>Interest</th><th>Message</th><th>Date</th><th>Status</th><th>Action</th>
        </tr></thead>
        <tbody>
          <% if (leads.length === 0) { %>
            <tr><td colspan="9" style="text-align:center;padding:3rem;color:var(--text-muted)">No leads yet. Share your site to start collecting!</td></tr>
          <% } else { %>
            <% leads.forEach(lead => { %>
            <tr>
              <td style="color:var(--text-primary);font-weight:500"><%= lead.full_name %></td>
              <td><a href="mailto:<%= lead.email %>" style="color:var(--bloom-primary-light)"><%= lead.email %></a></td>
              <td><%= lead.phone || '—' %></td>
              <td><%= lead.business_name || '—' %></td>
              <td><span class="badge <%= lead.interest === 'bundle' ? 'badge-primary' : lead.interest === 'voice' ? 'badge-accent' : 'badge-warning' %> status-badge"><%= lead.interest || 'general' %></span></td>
              <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= lead.message || '—' %></td>
              <td><%= new Date(lead.created_at).toLocaleDateString() %></td>
              <td><span class="badge <%= lead.status === 'new' ? 'badge-warning' : lead.status === 'converted' ? 'badge-success' : 'badge-primary' %> status-badge"><%= lead.status %></span></td>
              <td>
                <form action="/admin/leads/<%= lead.id %>/status" method="POST" style="display:flex;gap:0.3rem">
                  <select name="status" class="form-select" style="padding:0.25rem 0.4rem;font-size:0.75rem;width:auto">
                    <option value="new" <%= lead.status==='new'?'selected':'' %>>New</option>
                    <option value="contacted" <%= lead.status==='contacted'?'selected':'' %>>Contacted</option>
                    <option value="qualified" <%= lead.status==='qualified'?'selected':'' %>>Qualified</option>
                    <option value="converted" <%= lead.status==='converted'?'selected':'' %>>Converted</option>
                    <option value="lost" <%= lead.status==='lost'?'selected':'' %>>Lost</option>
                  </select>
                  <button type="submit" class="btn btn-ghost btn-sm">✓</button>
                </form>
              </td>
            </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
